{
  "name": "smart-expense-tracker-api",
  "version": "1.0.0",
  "description": "Production-quality REST API for tracking expenses with local JSON storage.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
